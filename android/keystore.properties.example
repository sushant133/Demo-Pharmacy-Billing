# Copy to android/keystore.properties and fill in. Never commit the real file
# or the .jks itself - losing either means you can never update the app on
# Play again under the same listing.
#
# Create the keystore (once, then back it up somewhere safe):
#   keytool -genkey -v -keystore pharmacy-counter-release.jks \
#     -alias pharmacy-counter -keyalg RSA -keysize 2048 -validity 10000

storeFile=C:/keystores/pharmacy-counter-release.jks
storePassword=
keyAlias=pharmacy-counter
keyPassword=
