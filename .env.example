# ---------------------------------------------------------------------------
# MantraPharma - environment variables
# Copy to `.env.local` for development, or `.env` for a PM2 production run.
# ---------------------------------------------------------------------------

# MongoDB connection string.
# Standalone (dev):        mongodb://127.0.0.1:27017/mantrapharma
# Replica set (prod):      mongodb://127.0.0.1:27017/mantrapharma?replicaSet=rs0
# Atlas:                   mongodb+srv://user:pass@cluster.mongodb.net/mantrapharma
#
# NOTE: multi-document transactions require a replica set. On a standalone
# server the app automatically falls back to guarded atomic stock decrements
# with compensating rollback (see lib/transaction.ts). A single-node replica
# set is recommended in production.
MONGODB_URI=mongodb://127.0.0.1:27017/mantrapharma
# Optional. Used when the URI has no /database path (common with Atlas).
# Mongoose would otherwise connect to `test`.
# MONGODB_DB=mantrapharma

# Secret used to sign session JWTs (HS256). Must be >= 32 characters.
# Generate with:  openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# How long a login session stays valid, in seconds. Default 12h (a work shift).
AUTH_SESSION_TTL=43200

# Business settings
VAT_RATE=0.13                 # Nepal standard VAT (13%). 0 disables VAT lines.
LOW_STOCK_THRESHOLD=20        # Units below which a medicine is "low stock".
EXPIRY_ALERT_DAYS=90          # Default window for the expiring-soon report.
# Expiry grading and reorder maths (lib/alert-rules.ts) use fixed defaults:
#   expiry bands   30 / 60 / 90 days  (critical / warning / watch)
#   target cover   45 days, lead time 7 days
#   sales window   trailing 90 days
# These are constants rather than env vars for now - change them there if a
# shop needs different thresholds.
BUSINESS_TIMEZONE=Asia/Kathmandu

# First-run defaults only. Once the app has started, the pharmacy's name, PAN,
# VAT registration, licences and contact details are edited on the Settings
# screen and stored in the database - these values are what a brand new
# install starts from, and what it falls back to if Mongo is unreachable.
BUSINESS_NAME=Mantra Pharmacy
BUSINESS_ADDRESS=
BUSINESS_PHONE=+977-1-0000000
BUSINESS_PAN=

# Credentials created by `npm run seed` (dev convenience only).
SEED_ADMIN_EMAIL=admin@mantrapharma.local
SEED_ADMIN_PASSWORD=Admin@123
