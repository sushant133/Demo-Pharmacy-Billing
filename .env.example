# ---------------------------------------------------------------------------
# MantraPharma - environment variables
# Copy to `.env.local` for development, or `.env` for a PM2 production run.
# ---------------------------------------------------------------------------

# MongoDB connection string.
# Standalone (dev):        mongodb://127.0.0.1:27017/mantrapharma
# Replica set (prod):      mongodb://127.0.0.1:27017/mantrapharma?replicaSet=rs0
# Atlas:                   mongodb+srv://user:pass@cluster.mongodb.net/mantrapharma
#
# NOTE: multi-document transactions require a replica set. On a standalone
# server the app automatically falls back to guarded atomic stock decrements
# with compensating rollback (see lib/transaction.ts). A single-node replica
# set is recommended in production.
MONGODB_URI=mongodb://127.0.0.1:27017/mantrapharma
# Optional. Used when the URI has no /database path (common with Atlas).
# Mongoose would otherwise connect to `test`.
# MONGODB_DB=mantrapharma

# Secret used to sign session JWTs (HS256). Must be >= 32 characters.
# Generate with:  openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# How long a login session stays valid, in seconds. Default 12h (a work shift).
AUTH_SESSION_TTL=43200

# Business settings
VAT_RATE=0.13                 # Nepal standard VAT (13%). 0 disables VAT lines.
LOW_STOCK_THRESHOLD=20        # Units below which a medicine is "low stock".
EXPIRY_ALERT_DAYS=90          # Default window for the expiring-soon report.
# Expiry grading and reorder maths (lib/alert-rules.ts) use fixed defaults:
#   expiry bands   30 / 60 / 90 days  (critical / warning / watch)
#   target cover   45 days, lead time 7 days
#   sales window   trailing 90 days
# These are constants rather than env vars for now - change them there if a
# shop needs different thresholds.
BUSINESS_TIMEZONE=Asia/Kathmandu

# First-run defaults only. Once the app has started, the pharmacy's name, PAN,
# VAT registration, licences and contact details are edited on the Settings
# screen and stored in the database - these values are what a brand new
# install starts from, and what it falls back to if Mongo is unreachable.
BUSINESS_NAME=Mantra Pharmacy
BUSINESS_ADDRESS=
BUSINESS_PHONE=+977-1-0000000
BUSINESS_PAN=

# Credentials created by `npm run seed` (dev convenience only).
SEED_ADMIN_EMAIL=admin@mantrapharma.local
SEED_ADMIN_PASSWORD=Admin@123
SEED_SUPERADMIN_EMAIL=superadmin@mantrapharma.local
SEED_SUPERADMIN_PASSWORD=Super@123

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Outbound mail is used for two things: the credentials sent to a pharmacy
# owner when their account is opened, and password-reset links.
#
# Leave SMTP_HOST blank and nothing is sent - each message is written to the
# server log in full instead, reset links included. That is the intended
# development setup, and it makes a production box that forgot to configure
# mail obvious in the log rather than silently dropping it.
#
# Two transports. A Google refresh token wins if both are set.
#
# --- Google (Gmail API) ------------------------------------------------
# Preferred. Uses the gmail.send scope only - it cannot read a mailbox.
# Create a Web OAuth client in Google Cloud, then mint the refresh token:
#   npx tsx scripts/google-mail-token.ts
#
# NOTE: while the OAuth consent screen is in "Testing", Google expires
# refresh tokens after 7 days. Publish the app before relying on this.
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# GOOGLE_MAIL_REFRESH_TOKEN=
# The address that granted consent. Gmail only sends as this or an alias.
# GOOGLE_MAIL_SENDER=you@yourdomain.com
#
# --- SMTP --------------------------------------------------------------
# Works with any SMTP relay. For Google Workspace use smtp.gmail.com:587 with
# an App Password, not the account password.
# SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Implicit TLS. Leave unset for 587/25 (STARTTLS); it is inferred for 465.
# SMTP_SECURE=false
# SMTP_USER=no-reply@yourdomain.com
# SMTP_PASSWORD=
# The From header. Must be an address the relay is allowed to send as.
MAIL_FROM=MantraMed <no-reply@mantramed.app>
# Optional. Where replies go, if that is not the From address.
# MAIL_REPLY_TO=support@yourdomain.com

# The origin a password-reset link points at, and where the email's logo is
# loaded from. Must be the address a user's browser can actually reach - the
# server cannot infer this reliably from behind a proxy. No trailing slash.
APP_URL=http://localhost:3000
